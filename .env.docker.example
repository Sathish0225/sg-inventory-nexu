# Copy to .env for docker compose.
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
SEED_ADMIN_EMAIL=admin@yourcompany.sg
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
APP_PORT=3001
# Keep true behind HTTPS. Set false only if staff open the app via http://<server LAN IP>.
COOKIE_SECURE=true
# true when behind a reverse proxy
TRUST_PROXY=false
