{
  "name": "inventrack-desktop",
  "productName": "InvenTrack SG",
  "version": "1.0.0",
  "description": "InvenTrack SG desktop app",
  "private": true,
  "main": "main.cjs",
  "author": {
    "name": "InvenTrack SG",
    "email": "support@example.com"
  },
  "scripts": {
    "copy-web": "node scripts/copy-web.cjs",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --publish never",
    "dist:win": "npm run copy-web && electron-builder --win --publish never",
    "dist:mac": "npm run copy-web && electron-builder --mac --publish never",
    "dist:linux": "npm run copy-web && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "sg.inventrack.desktop",
    "productName": "InvenTrack SG",
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "InvenTrack SG <support@example.com>"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/Sathish0225/sg-inventory-nexu"
}
