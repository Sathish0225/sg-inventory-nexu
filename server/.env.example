# PostgreSQL connection string
DATABASE_URL="postgresql://inventrack:change-me@localhost:5432/inventrack?schema=public"
# Long random string used to sign login sessions. Generate with: openssl rand -base64 48
JWT_SECRET=""
# Port the API (and, in production, the built web app) listens on
PORT=3001
# Set to "production" when deployed behind HTTPS (enables secure cookies)
NODE_ENV=development
# First admin account created by `npm run db:seed` (only when no users exist)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
# Load demo customers, stock and documents when seeding (true/false)
SEED_DEMO_DATA=true
LOGIN_RATE_LIMIT=10
# true only when behind a reverse proxy (nginx/Caddy/load balancer)
TRUST_PROXY=false
# Secure (HTTPS-only) session cookie; defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
